# Copy to .env (gitignored) and fill in. Compose reads it automatically.
#
# Bearer token required by the MCP endpoint. Generate one:
#   openssl rand -hex 24
MCPX_TOKEN=

# Host-side publish address. Loopback keeps the gateway off the network until a
# reverse proxy is in front of it; set 0.0.0.0 only behind a firewall.
MCPX_BIND=127.0.0.1
MCPX_PORT=8848

# Absolute or ./relative path to the config mounted at /etc/mcpx/mcpx.yaml.
MCPX_CONFIG_FILE=./deploy/mcpx.docker.yaml

# Optional upstream credentials referenced by the mounted config.
DEMO_TOKEN=
